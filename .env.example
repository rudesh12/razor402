# Razorpay TEST MODE keys only. Never live keys.
RZP_KEY_ID=rzp_test_xxxxxxxxxxxx
RZP_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RZP_WEBHOOK_SECRET=whsec_local_demo_secret
RZP_MODE=auto                 # auto | live_s2s | harness

# Gateway signing key (hex, 32 bytes). Generate with: python scripts/keygen.py
GW_SK_HEX=
AGENT_A_SK_HEX=
AGENT_B_SK_HEX=

DB_PATH=razor402.db
UPSTREAM_URL=http://127.0.0.1:9000
GATEWAY_URL=http://127.0.0.1:8000

# LLM: optional. Demo runs from fixture without these.
LLM_PROVIDER=anthropic        # anthropic | gemini | none
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
